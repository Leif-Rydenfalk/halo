  (attr smd exclude_from_pos_files exclude_from_bom)
  (pad "1" smd rect (at 0 0) (size 1.80 1.80) (layers "F.Cu" "F.Mask"))
  (fp_line (start -1.000 -1.000) (end 1.000 -1.000) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 1.000 -1.000) (end 1.000 1.000) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 1.000 1.000) (end -1.000 1.000) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -1.000 1.000) (end -1.000 -1.000) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
)
