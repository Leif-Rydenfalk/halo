(footprint "HALO_SERIAL_MARK_1X8"
  (version 20240108)
  (generator "halo/footprints.py")
  (layer "F.Cu")
  (descr "halo serial mark land: 1.8 x 1.8 mm bare copper, mask opened, for a laser-marked ECC200 DataMatrix. Probed face, same side as the fiducials.")
