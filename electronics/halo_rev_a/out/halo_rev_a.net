			(description "Resistor")
			(fields
				(field
					(name "LCSC") "C25076")
				(field
					(name "MPN") "0201WMF1000TEE")
				(field
					(name "Manufacturer") "UNI-ROYAL")
				(field
					(name "Note") "series damping on one leg. A bender is a near-pure capacitance and a GPIO edge into it is a current spike straight off the bulk caps; 100 R holds the peak near 30 mA and costs 0.2 dB at 4 kHz into ~500 ohm.")
				(field
					(name "Price@1k") "$0.0012")
				(field
