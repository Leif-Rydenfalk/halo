			(ref "BT1")
			(value "CR2032")
			(footprint "halo:HALO_BATT_CONTACT_3PAD")
			(datasheet "https://industrial.panasonic.com/cdbs/www-data/pdf/AAC4000/AAC4000CE7.pdf")
			(description "CR2032 on three sprung C5191 fingers: two on the positive can rim, one on the negative face. One positive finger carries current, the other is sense only - halo rev A D-5.  [pinout: Adam Catley AirTag teardown (2 positive + 1 negative carrier-side contacts, fetched 2026-09-03) and lane M's ce-designs/halo/design.py R_CONTACT_POS = 9.50 / R_CONTACT_NEG = 6.00, A_SPRING_DEG = 30.]")
			(fields
				(field
					(name "LCSC Part #") "NO ORDER CODE - NOT AN SMT LINE")
				(field
					(name "MPN") "CR2032")
				(field
					(name "Manufacturer") "Panasonic")
				(field
					(name "Note") "THE CELL IS BOUGHT, THE HOLDER IS NOT: no part is fitted on BT1 - the contacts are three stamped C5191 fingers on halo's OWN land pattern. S1 2026-09-05: the code this line carried, C7498149, is a Lian Xin BS-CR2032-8 SMD BATTERY HOLDER, which must not be ordered and cannot be fitted on this footprint. Pad 1 = P+ current finger, pad 3 = P+ SENSE finger, pad 2 = negative.")
				(field
					(name "Footprint") "halo:HALO_BATT_CONTACT_3PAD")
				(field
					(name "Datasheet") "https://industrial.panasonic.com/cdbs/www-data/pdf/AAC4000/AAC4000CE7.pdf")
