		(comp
			(ref "R9")
			(value "100R")
			(footprint "Resistor_SMD:R_0201_0603Metric")
			(datasheet "~")
			(description "Resistor")
			(fields
				(field
					(name "LCSC") "C25076")
				(field
					(name "MPN") "0201WMF1000TEE")
				(field
					(name "Manufacturer") "UNI-ROYAL")
				(field
					(name "Note") "series damping on one leg, and it EARNS ITS PLACE - measured, not argued. A bender is a near-pure capacitance and a GPIO edge into it is a current spike off the bulk capacitors. sim/sounder_drive.py: with a low-loss 40 nF bender the peak pin current is 32.0 mA with R9 removed and 17.8 mA with it fitted - a 44 % cut, and the difference between exceeding and clearing a 25 mA ceiling. An earlier note here said '100 R holds the peak near 30 mA', which had the right magnitude and the wrong side of it.")
				(field
					(name "Price@1k") "$0.0012")
				(field
					(name "Priced") "2026-09-03")
				(field
					(name "Stock") "in stock")
				(field
					(name "Footprint") "Resistor_SMD:R_0201_0603Metric")
				(field
					(name "Datasheet") "~")
				(field
					(name "Description") "Resistor")
			)
			(libsource
				(lib "Device")
				(part "R")
				(description "Resistor")
			)
			(property
				(name "LCSC")
				(value "C25076")
			)
			(property
				(name "MPN")
				(value "0201WMF1000TEE")
			)
			(property
				(name "Manufacturer")
				(value "UNI-ROYAL")
			)
			(property
				(name "Note")
				(value "series damping on one leg, and it EARNS ITS PLACE - measured, not argued. A bender is a near-pure capacitance and a GPIO edge into it is a current spike off the bulk capacitors. sim/sounder_drive.py: with a low-loss 40 nF bender the peak pin current is 32.0 mA with R9 removed and 17.8 mA with it fitted - a 44 % cut, and the difference between exceeding and clearing a 25 mA ceiling. An earlier note here said '100 R holds the peak near 30 mA', which had the right magnitude and the wrong side of it.")
			)
			(property
				(name "Price@1k")
				(value "$0.0012")
			)
