#!/usr/bin/env python3
"""boardmetro - measure a printed circuit board off a photograph, or refuse.

Built for the halo Replica lane because no instrument for this existed in the workshop.
Leif, 2026-09-05: "always manage its own tools and create any tools that might be missing."

THREE VERDICTS, and they are the exit code:
    0  PASS              a number, with the input it came from
    1  FAIL              the measurement ran and the answer is wrong / out of tolerance
    2  CANNOT DETERMINE  the photograph does not support the measurement. NEVER a default.

WHY THE NEGATIVE CONTROLS EXIST. Measuring this project's first board edge produced
394 px, which was the CROP FRAME and not the board - O'Flynn's marker circle is inscribed
tangent to the square frame, so a ray-cast for "outermost dark" finds the frame every time.
It was caught only because the number landed exactly on the search cap and a human noticed.
Every measurement verb here therefore carries a control that fails when the answer is an
artifact of the search itself, so the next one is caught without anybody having to notice.

VERBS
    doctor              dependencies, catalogue, and a canary measurement with a known answer
    selftest            synthetic ground truth + deliberate breaks. Run before trusting output.
    scale-ruler IMG     px/mm from a ruler's tick pitch (periodic signal, not two picked ticks)
    circle IMG          fit a circle; refuses when the fit is really the frame
    radial IMG          radial luma/chroma profile about a centre
    rect IMG            rectangles by BOUNDARY EVIDENCE (straight-edge coherence), not by
                        intensity level - for IC package bodies that no brightness or colour
                        threshold separates from bare soldermask
    rect-selftest       the rect engine's own synthetic ground truth and deliberate breaks

Every verb prints the INPUT it used - filename, region, method, basis - because three
antenna results in this project were correct computations on the wrong board, and the
input line is the only thing that catches that.
"""
import sys, os, json, argparse, math

EX_PASS, EX_FAIL, EX_CANNOT = 0, 1, 2
HALO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
IMGDIR = os.path.abspath(os.path.join(HALO, "..", "..", "images", "airtag"))

def _np():
    import numpy as np; return np
def _img(path):
    from PIL import Image
    if not os.path.exists(path):
        p2 = os.path.join(IMGDIR, path)
        if os.path.exists(p2): path = p2
        else: die_cannot(f"no such image: {path}")
    return path, Image.open(path)

def die_cannot(why, **extra):
    print(f"CANNOT DETERMINE: {why}")
    for k, v in extra.items(): print(f"  {k}: {v}")
    sys.exit(EX_CANNOT)
def die_fail(why, **extra):
    print(f"FAIL: {why}")
    for k, v in extra.items(): print(f"  {k}: {v}")
    sys.exit(EX_FAIL)

# ---------------------------------------------------------------- circle fitting
def kasa(x, y, w):
    np = _np()
    A = np.stack([x, y, np.ones_like(x)], 1) * w[:, None]
    b = (x * x + y * y) * w
    sol, *_ = np.linalg.lstsq(A, b, rcond=None)
    cx, cy = sol[0] / 2, sol[1] / 2
    return cx, cy, math.sqrt(max(sol[2] + cx * cx + cy * cy, 1e-12))

def shape_evidence(xs, ys, cx, cy, r, keep):
    """Residual over INLIERS cannot test shape - IRLS chose the inliers to make it small.
    That is a check that can agree with what it checks. Found by this tool's own selftest:
    a SQUARE fitted as a circle gave residual sd 1.15 px, under the 2.0 px threshold.
    So shape is judged on evidence IRLS could not manufacture: how much of the candidate
    set survived, and whether the survivors go all the way round."""
    np = _np()
    frac = float(keep.mean()) if len(keep) else 0.0
    th = np.degrees(np.arctan2(ys[keep] - cy, xs[keep] - cx)) % 360 if keep.sum() else np.array([])
    counts = np.histogram(th, bins=36, range=(0, 360))[0] if len(th) else np.zeros(36)
    occupied = int((counts > 0).sum())
    expected = counts.sum() / 36.0 if counts.sum() else 0.0
    # a thin full ring is near-uniform in angle; a square's survivors bunch and leave gaps
    uniformity = float(counts.min() / expected) if expected > 0 else 0.0
    return frac, occupied, uniformity


def fit_circle(xs, ys, iters=30, band=2.0):
    np = _np()
    x = xs.astype(float); y = ys.astype(float); w = np.ones_like(x)
    cx, cy, r = kasa(x, y, w)
    for i in range(iters):
        d = np.abs(np.hypot(x - cx, y - cy) - r)
        bw = max(band, 3.0 * 1.4826 * np.median(d)) if i < 8 else band
        w = (d < bw).astype(float)
        if w.sum() < 20: break
        cx, cy, r = kasa(x, y, w)
    keep = w > 0
    res = np.hypot(x[keep] - cx, y[keep] - cy) - r if keep.sum() else np.array([0.0])
    return cx, cy, r, keep, res

def frame_control(cx, cy, r, W, H, tol=1.5):
    """NEGATIVE CONTROL. A circle inscribed tangent to the image frame is the CROP, not the
    board. This is the exact failure that produced 394 px. Returns a reason, or None."""
    hits = []
    if abs((cx - r) - 0) < tol: hits.append("tangent to left edge")
    if abs((cy - r) - 0) < tol: hits.append("tangent to top edge")
    if abs((cx + r) - (W - 1)) < tol: hits.append("tangent to right edge")
    if abs((cy + r) - (H - 1)) < tol: hits.append("tangent to bottom edge")
    if len(hits) >= 3:
        return ("the fitted circle is inscribed in the image frame (" + ", ".join(hits) +
                ") - this is the CROP BOUNDARY, not a board feature")
    return None

# ---------------------------------------------------------------- verbs
def v_circle(a):
    np = _np()
    path, im = _img(a.image)
    full = np.asarray(im.convert("L")).astype(float)
    FH, FW = full.shape
    ox = oy = 0
    if getattr(a, "region", None):
        x0, y0, x1, y1 = a.region
        if not (0 <= x0 < x1 <= FW and 0 <= y0 < y1 <= FH):
            die_cannot(f"region {a.region} outside image {FW}x{FH}")
        arr = full[y0:y1, x0:x1]
        ox, oy = x0, y0
    else:
        arr = full
    H, W = arr.shape
    from scipy import ndimage as ndi
    med = ndi.median_filter(arr, size=a.ground_window)
    cand = (arr < a.dark) & (med > a.ground)
    ys, xs = np.nonzero(cand)
    print(f"INPUT  image={os.path.basename(path)}  {FW}x{FH}"
          + (f"  region [{ox}:{ox+W},{oy}:{oy+H}] ({W}x{H} px)" if a.region else "  (whole image)"))
    print(f"       method=dark(<{a.dark}) on bright ground(median{a.ground_window}>{a.ground}), Kasa+IRLS band {a.band}px")
    if a.region:
        print("       NOTE with --region the SEARCH FRAME is the region, so the frame "
              "control tests tangency to the REGION's edges - which is the right test: a "
              "circle that fills the box you drew is a measurement of the box.")
    if len(ys) < a.min_pixels:
        die_cannot(f"only {len(ys)} candidate pixels, need {a.min_pixels}",
                   hint="loosen --dark / --ground, or this image has no such feature")
    cx, cy, r, keep, res = fit_circle(xs, ys, band=a.band)
    if keep.sum() < a.min_pixels:
        die_cannot(f"fit collapsed to {int(keep.sum())} inliers")
    sd = float(res.std())
    frac, occ36, unif = shape_evidence(xs, ys, cx, cy, r, keep)
    th = np.degrees(np.arctan2(ys[keep] - cy, xs[keep] - cx)) % 360
    occupied = int((np.histogram(th, bins=12, range=(0, 360))[0] > 0).sum())
    print(f"RESULT centre=({cx+ox:.2f},{cy+oy:.2f}) px in the SOURCE image  r={r:.2f} px  "
          f"inliers={int(keep.sum())}/{len(xs)}"
          + (f"   [region-local centre ({cx:.2f},{cy:.2f})]" if a.region else ""))
    print(f"       residual sd={sd:.3f} px  p95|res|={float(np.percentile(np.abs(res),95)):.3f} px")
    print(f"       angular coverage {occupied}/12 of 30deg bins")
    print(f"SHAPE  inlier fraction {frac:.3f} (need >={a.min_inlier_frac})  "
          f"36-bin coverage {occ36}/36  angular uniformity {unif:.3f}"
          + (f" (need >={a.min_uniformity})" if a.min_uniformity > 0 else " (diagnostic only)"))
    if frac < a.min_inlier_frac:
        die_fail(f"inlier fraction {frac:.3f} below --min-inlier-frac {a.min_inlier_frac}",
                 meaning="most candidate pixels are NOT on the fitted circle - the feature "
                         "is some other shape and IRLS merely carved a circle out of it")
    if a.min_uniformity > 0 and unif < a.min_uniformity:
        die_fail(f"angular uniformity {unif:.3f} below --min-uniformity {a.min_uniformity}",
                 meaning="survivors bunch in angle and leave gaps. Only meaningful when the "
                         "feature is EXPECTED to be a complete ring - a circle clipped by the "
                         "crop legitimately occupies few bins, so this is opt-in, not default")
    if sd > a.max_residual:
        die_fail(f"residual sd {sd:.3f} px exceeds --max-residual {a.max_residual}",
                 meaning="the inliers are not on one circle; this is not a circular feature")
    if occupied < a.min_arcs:
        die_cannot(f"only {occupied}/12 angular bins occupied (need {a.min_arcs})",
                   meaning="too little arc to constrain a centre; radius would be unreliable")
    ctrl = frame_control(cx, cy, r, W, H)
    if ctrl:
        if a.expect_frame:
            print(f"CONTROL fired as expected: {ctrl}")
        else:
            die_fail("NEGATIVE CONTROL FIRED: " + ctrl,
                     remedy="if you meant to measure the crop marker, pass --expect-frame")
    else:
        print("CONTROL passed: not inscribed in the frame")
    if a.mm is not None:
        pxmm = 2 * r / a.mm
        print(f"SCALE  {2*r:.2f} px = {a.mm} mm  ->  {pxmm:.4f} px/mm  ({1/pxmm:.6f} mm/px)")
        print(f"       NOTE any absolute mm derived from this inherits whatever error is in "
              f"the {a.mm} mm figure. Ratios do not.")
    if a.json_out:
        json.dump({"image": os.path.basename(path), "image_w": FW, "image_h": FH,
                   "region": list(a.region) if a.region else None,
                   "cx_px": cx + ox, "cy_px": cy + oy,
                   "cx_px_region_local": cx, "cy_px_region_local": cy,
                   "r_px": r, "inliers": int(keep.sum()),
                   "residual_sd_px": sd, "angular_bins_occupied": occupied,
                   "method": f"dark<{a.dark} on median{a.ground_window}>{a.ground}, Kasa+IRLS",
                   "frame_control": ctrl or "passed"},
                  open(a.json_out, "w"), indent=2)
        print(f"WROTE  {a.json_out}")
    return EX_PASS

def v_scale_ruler(a):
    """px/mm from a ruler's tick pitch, via autocorrelation of a strip. A pitch averaged
    over many ticks beats two hand-picked ones and yields a residual."""
    np = _np()
    path, im = _img(a.image)
    arr = np.asarray(im.convert("L")).astype(float)
    H, W = arr.shape
    x0, y0, x1, y1 = a.region
    if not (0 <= x0 < x1 <= W and 0 <= y0 < y1 <= H):
        die_cannot(f"region {a.region} outside image {W}x{H}")
    strip = arr[y0:y1, x0:x1]
    sig = strip.mean(axis=0 if a.axis == "x" else 1)
    print(f"INPUT  image={os.path.basename(path)}  {W}x{H}  region={a.region}  axis={a.axis}")
    print(f"       strip {strip.shape}, collapsed to {len(sig)} samples")
    sig = sig - sig.mean()
    if sig.std() < 1.0:
        die_cannot(f"strip has almost no contrast (sd {sig.std():.2f}) - no ticks here")
    ac = np.correlate(sig, sig, mode="full")[len(sig) - 1:]
    ac = ac / ac[0]
    lo, hi = a.min_pitch, min(a.max_pitch, len(ac) - 1)
    if hi <= lo: die_cannot(f"pitch search range [{lo},{hi}] is empty")
    seg = ac[lo:hi]
    k = int(np.argmax(seg)) + lo
    peak = float(ac[k])
    # parabolic refinement on the autocorrelation peak
    if 1 <= k < len(ac) - 1:
        d = ac[k-1] - 2*ac[k] + ac[k+1]
        k_ref = k + (0.5*(ac[k-1]-ac[k+1])/d) if abs(d) > 1e-9 else float(k)
    else: k_ref = float(k)
    print(f"RESULT tick pitch {k_ref:.3f} px  (autocorrelation peak {peak:.3f} at lag {k})")
    if peak < a.min_peak:
        die_cannot(f"autocorrelation peak {peak:.3f} below --min-peak {a.min_peak}",
                   meaning="no convincing periodicity - this strip is probably not on the ticks")
    # NEGATIVE CONTROL: the peak must beat a shuffled version of the same signal
    rng = np.random.default_rng(0)
    ctrl_peaks = []
    for _ in range(a.control_trials):
        s2 = rng.permutation(sig)
        a2 = np.correlate(s2, s2, mode="full")[len(s2)-1:]
        a2 = a2 / a2[0]
        ctrl_peaks.append(float(a2[lo:hi].max()))
    cmax = max(ctrl_peaks)
    print(f"CONTROL shuffled-signal best peak over {a.control_trials} trials: {cmax:.3f}")
    if peak <= cmax:
        die_fail(f"peak {peak:.3f} does not beat shuffled control {cmax:.3f}",
                 meaning="the periodicity is not distinguishable from chance")
    print(f"CONTROL passed: {peak:.3f} > {cmax:.3f}")
    pxmm = k_ref / a.pitch_mm
    print(f"SCALE  {k_ref:.3f} px = {a.pitch_mm} mm  ->  {pxmm:.4f} px/mm  ({1/pxmm:.6f} mm/px)")
    print(f"       basis is a RULER IN THE PHOTOGRAPH, so this does not inherit any")
    print(f"       assumed board dimension. Perspective error is NOT bounded by this verb.")
    if a.json_out:
        json.dump({"image": os.path.basename(path), "region": list(a.region), "axis": a.axis,
                   "tick_pitch_px": k_ref, "pitch_mm": a.pitch_mm, "px_per_mm": pxmm,
                   "mm_per_px": 1/pxmm, "autocorr_peak": peak, "shuffle_control_peak": cmax,
                   "method": "autocorrelation of collapsed strip, parabolic peak refinement",
                   "caveat": "perspective/parallax not bounded by this measurement"},
                  open(a.json_out, "w"), indent=2)
        print(f"WROTE  {a.json_out}")
    return EX_PASS

def v_radial(a):
    np = _np()
    path, im = _img(a.image)
    rgb = np.asarray(im.convert("RGB")).astype(float)
    lum = rgb.mean(2); H, W, _ = rgb.shape
    cx, cy = (a.centre if a.centre else ((W-1)/2, (H-1)/2))
    ys, xs = np.mgrid[0:H, 0:W]
    rad = np.hypot(ys - cy, xs - cx)
    if a.copper:
        sel = (rgb[...,0] - rgb[...,2] > 28) & (rgb[...,0] > 90) & (lum < 250)
        what = "copper-chroma fraction (R-B>28, R>90, not blown)"
    else:
        sel = None; what = "mean luma"
    print(f"INPUT  image={os.path.basename(path)}  {W}x{H}  centre=({cx:.2f},{cy:.2f})  {what}")
    if a.px_per_mm: print(f"       scale {a.px_per_mm:.4f} px/mm")
    rows = []
    for r0 in np.arange(a.r_min, a.r_max, a.bin):
        m = (rad >= r0) & (rad < r0 + a.bin)
        n = int(m.sum())
        if n < 20: continue
        val = float(sel[m].mean()) if sel is not None else float(lum[m].mean())
        rows.append((float(r0 + a.bin/2), val, n))
    if not rows: die_cannot("no radial bin had enough pixels")
    for r, v, n in rows:
        mm = f" {r/a.px_per_mm:7.3f} mm" if a.px_per_mm else ""
        bar = "#" * int(v * 60) if sel is not None else "#" * int(v / 255 * 60)
        print(f"  r={r:6.1f} px{mm}  {v:7.3f}  {bar}")
    if a.json_out:
        json.dump({"image": os.path.basename(path), "centre_px": [cx, cy],
                   "quantity": what, "px_per_mm": a.px_per_mm,
                   "bins": [{"r_px": r, "value": v, "n": n} for r, v, n in rows]},
                  open(a.json_out, "w"), indent=2)
        print(f"WROTE  {a.json_out}")
    return EX_PASS

# ---------------------------------------------------------------- doctor / selftest
def _synth(kind, W=600, H=600, **kw):
    np = _np(); from PIL import Image
    a = np.full((H, W), 240, dtype=np.uint8)
    if kind == "circle":
        cx, cy, r = kw["cx"], kw["cy"], kw["r"]
        ys, xs = np.mgrid[0:H, 0:W]
        d = np.abs(np.hypot(ys - cy, xs - cx) - r)
        a[d < kw.get("w", 1.2)] = 30
    elif kind == "inscribed":
        cx, cy, r = (W-1)/2, (H-1)/2, (W-1)/2
        ys, xs = np.mgrid[0:H, 0:W]
        d = np.abs(np.hypot(ys - cy, xs - cx) - r)
        a[d < 1.2] = 30
    elif kind == "ruler":
        pitch = kw["pitch"]
        for i in range(int(W / pitch)):
            x = int(round(i * pitch))
            if 0 <= x < W: a[H//3:2*H//3, x:x+2] = 20
    elif kind == "noise":
        rng = np.random.default_rng(kw.get("seed", 1))
        a = rng.integers(0, 255, (H, W), dtype=np.uint8)
    elif kind == "blank":
        pass
    return Image.fromarray(a)

def v_selftest(a):
    """Ground truth we generate, plus DELIBERATE BREAKS. A check never seen to go red is
    not known to work, so every control here is fired on purpose at least once."""
    np = _np()
    import tempfile
    tmp = tempfile.mkdtemp(prefix="boardmetro-selftest-")
    results = []
    def rec(name, ok, detail):
        results.append((name, ok, detail))
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: {detail}")

    print("boardmetro selftest - synthetic ground truth and deliberate breaks\n")

    # 1 POSITIVE: a circle we drew, recovered
    for r_true, cx_t, cy_t in ((180.0, 300.0, 300.0), (95.5, 250.0, 330.0), (240.0, 300.0, 300.0)):
        p = os.path.join(tmp, f"c{r_true}.png")
        _synth("circle", cx=cx_t, cy=cy_t, r=r_true).save(p)
        arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
        ys, xs = np.nonzero(arr < 100)
        cx, cy, r, keep, res = fit_circle(xs, ys)
        err = abs(r - r_true)
        rec(f"recover drawn circle r={r_true}", err < 1.0,
            f"got r={r:.3f} (err {err:.3f} px), centre err "
            f"{math.hypot(cx-cx_t, cy-cy_t):.3f} px, res sd {res.std():.3f}")

    # 2 NEGATIVE CONTROL fired on purpose: inscribed circle = the frame
    p = os.path.join(tmp, "inscribed.png"); _synth("inscribed").save(p)
    arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
    ys, xs = np.nonzero(arr < 100)
    cx, cy, r, keep, res = fit_circle(xs, ys)
    ctrl = frame_control(cx, cy, r, arr.shape[1], arr.shape[0])
    rec("frame control FIRES on an inscribed circle", ctrl is not None,
        ctrl or "control did NOT fire - the 394 px defect would ship again")

    # 3 the same control must NOT fire on a legitimate inner circle
    p = os.path.join(tmp, "inner.png"); _synth("circle", cx=300, cy=300, r=180).save(p)
    arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
    ys, xs = np.nonzero(arr < 100)
    cx, cy, r, keep, res = fit_circle(xs, ys)
    ctrl2 = frame_control(cx, cy, r, arr.shape[1], arr.shape[0])
    rec("frame control STAYS QUIET on an inner circle", ctrl2 is None,
        ctrl2 or "quiet, as it should be")

    # 4 POSITIVE: ruler pitch recovered by autocorrelation
    for pitch_true in (12.0, 30.0, 7.5):
        p = os.path.join(tmp, f"r{pitch_true}.png"); _synth("ruler", pitch=pitch_true).save(p)
        arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
        sig = arr[arr.shape[0]//3:2*arr.shape[0]//3, :].mean(0); sig = sig - sig.mean()
        ac = np.correlate(sig, sig, mode="full")[len(sig)-1:]; ac = ac/ac[0]
        lo = max(3, int(pitch_true*0.5)); hi = int(pitch_true*2)
        k = int(np.argmax(ac[lo:hi])) + lo
        rec(f"recover ruler pitch {pitch_true} px", abs(k - pitch_true) <= 1.0,
            f"got {k} px (peak {ac[k]:.3f})")

    # 5 NEGATIVE CONTROL: pure noise must NOT yield a confident pitch
    p = os.path.join(tmp, "noise.png"); _synth("noise").save(p)
    arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
    sig = arr[200:400, :].mean(0); sig = sig - sig.mean()
    ac = np.correlate(sig, sig, mode="full")[len(sig)-1:]; ac = ac/ac[0]
    npk = float(ac[6:120].max())
    rec("noise gives NO convincing periodicity", npk < 0.5,
        f"best peak {npk:.3f} (must stay under the --min-peak default 0.5)")

    # 6 NEGATIVE CONTROL: a blank image must be CANNOT DETERMINE, not a number
    p = os.path.join(tmp, "blank.png"); _synth("blank").save(p)
    arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
    ys, xs = np.nonzero(arr < 100)
    rec("blank image yields no candidates (-> CANNOT DETERMINE)", len(ys) == 0,
        f"{len(ys)} candidate pixels")

    # 7 DELIBERATE BREAK: feed the circle fitter a SQUARE and require it to be rejected
    from PIL import Image as _I
    a2 = np.full((600, 600), 240, dtype=np.uint8)
    a2[150:450, 150:158] = 30; a2[150:450, 442:450] = 30
    a2[150:158, 150:450] = 30; a2[442:450, 150:450] = 30
    p = os.path.join(tmp, "square.png"); _I.fromarray(a2).save(p)
    ys, xs = np.nonzero(a2 < 100)
    cx, cy, r, keep, res = fit_circle(xs, ys)
    frac, occ36, unif = shape_evidence(xs, ys, cx, cy, r, keep)
    rec("a SQUARE is rejected by INLIER FRACTION (the default gate)", frac < 0.85,
        f"inlier frac {frac:.3f}, uniformity {unif:.3f}, residual sd {res.std():.3f} px "
        f"- note the residual ALONE would have passed it, which is why it is not the test")

    # 8 the shape evidence must NOT reject a genuine full ring
    p = os.path.join(tmp, "ring.png"); _synth("circle", cx=300, cy=300, r=200).save(p)
    arr = np.asarray(__import__("PIL.Image", fromlist=["Image"]).open(p).convert("L")).astype(float)
    ys, xs = np.nonzero(arr < 100)
    cx, cy, r, keep, res = fit_circle(xs, ys)
    frac, occ36, unif = shape_evidence(xs, ys, cx, cy, r, keep)
    rec("shape evidence ACCEPTS a genuine ring", frac >= 0.85 and unif >= 0.15,
        f"inlier frac {frac:.3f}, uniformity {unif:.3f}, 36-bin coverage {occ36}/36")

    # 9 a circle CLIPPED by the crop must still be accepted - angular completeness is not
    #   circularity, and gating on it rejected the real O'Flynn marker circle on first try
    p = os.path.join(tmp, "clipped.png")
    im9 = _synth("circle", cx=300, cy=300, r=280)
    a9 = np.asarray(im9).copy(); a9[:, :] = np.where(a9 < 100, a9, 240)
    a9[100:500, :] = 240   # erase the left/right arcs, leaving top and bottom only
    _I.fromarray(a9).save(p)
    ys, xs = np.nonzero(a9 < 100)
    if len(ys) > 50:
        cx, cy, r, keep, res = fit_circle(xs, ys)
        frac, occ36, unif = shape_evidence(xs, ys, cx, cy, r, keep)
        rec("a CLIPPED circle is still accepted", frac >= 0.85 and abs(r - 280) < 2.0,
            f"r={r:.2f} (true 280), inlier frac {frac:.3f}, uniformity {unif:.3f} "
            f"- uniformity is low and that is CORRECT, which is why it is not a default gate")
    else:
        rec("a CLIPPED circle is still accepted", False, "synthetic clip left no pixels")

    # (nfail is computed at the END, after every case - see below. It used to be
    # computed here, so any case added after this line could not turn the suite red:
    # a selftest that cannot fail, in the selftest. L8 2026-09-05.)
    # 14 --region: the centre must come back in SOURCE pixels, not region-local.
    # L8 2026-09-05. An origin that is not added back is the classic form of E07 s14 -
    # the break and the check on opposite sides of a coordinate change - and it would
    # put a real connector 1500 px from where it is with nothing looking wrong.
    from PIL import Image as _I2
    big = np.full((900, 1200), 240, dtype=np.uint8)
    cx_t, cy_t, r_t = 800.0, 620.0, 60.0
    yy, xx = np.mgrid[0:900, 0:1200]
    rr = np.hypot(xx - cx_t, yy - cy_t)
    big[(rr > r_t - 1.2) & (rr < r_t + 1.2)] = 30   # a THIN ring: a 6 px-wide one puts
    # only ~2/3 of its own pixels inside the 2 px IRLS band and is refused by the inlier
    # gate, which is the gate working correctly and not a region bug. Watched happen.
    p = os.path.join(tmp, "region.png"); _I2.fromarray(big).save(p)

    class _A:
        image = p; dark = 190.0; ground = 225.0; ground_window = 15; band = 2.0
        min_pixels = 100; min_arcs = 3; max_residual = 2.0; min_inlier_frac = 0.85
        min_uniformity = 0.0; mm = None; expect_frame = False; json_out = None
        region = None
    A = _A(); A.json_out = os.path.join(tmp, "region.json")
    A.region = [660, 480, 940, 760]          # generous: circle well inside the box
    import io, contextlib
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            v_circle(A)
        got = json.load(open(A.json_out))
        derr = math.hypot(got["cx_px"] - cx_t, got["cy_px"] - cy_t)
        rerr = abs(got["r_px"] - r_t)
        local_ok = abs(got["cx_px_region_local"] - (cx_t - 660)) < 1.0
        rec("--region returns the centre in SOURCE pixels",
            derr < 1.0 and rerr < 1.0 and local_ok,
            f"source centre ({got['cx_px']:.2f},{got['cy_px']:.2f}) vs true "
            f"({cx_t},{cy_t}), err {derr:.3f} px; r={got['r_px']:.2f} (true {r_t}); "
            f"region-local x {got['cx_px_region_local']:.2f} (true {cx_t-660})")
    except SystemExit as e:
        rec("--region returns the centre in SOURCE pixels", False,
            f"exited {e.code}: {buf.getvalue().strip()[-200:]}")

    # 15 DELIBERATE BREAK: draw the region tight around the circle. The frame control
    # must FIRE, because with --region the box IS the search frame - "the answer is the
    # box" for circle. Fired on purpose so it is known to work.
    A2 = _A(); A2.json_out = None
    A2.region = [int(cx_t - r_t), int(cy_t - r_t),
                 int(cx_t + r_t + 1), int(cy_t + r_t + 1)]
    buf2 = io.StringIO()
    code = None
    try:
        with contextlib.redirect_stdout(buf2):
            v_circle(A2)
        code = EX_PASS
    except SystemExit as e:
        code = e.code
    out2 = buf2.getvalue()
    frame_fired = "NEGATIVE CONTROL FIRED" in out2
    refused = code != EX_PASS
    rec("a --region drawn tight around the circle is REFUSED", refused,
        ("refused, exit %s, by: %s" % (code, "the frame control" if frame_fired
         else out2.strip().split(chr(10))[-2] if len(out2.strip().split(chr(10))) > 1
         else out2.strip()))
        if refused else "PUBLISHED a number for a circle that fills its own search box")
    # And the honest second half: which control caught it. WITH --region a box this tight
    # starves the median-filter ground estimate, so the INLIER FRACTION gate fires first
    # and the frame control never runs. The refusal is right and its stated reason is not
    # the one the box deserved. Recorded as a KNOWN ORDERING, asserted so that a future
    # change which makes the frame control fire here goes red HERE and gets read, rather
    # than silently altering what the tool says about a box.
    rec("...and the reason is the inlier-fraction gate, not the frame control "
        "(a KNOWN ORDERING, asserted so a change to it is noticed)",
        refused and not frame_fired,
        "inlier fraction fired first, as it does whenever --region starves the ground "
        "estimate. If this ever goes red the frame control started reaching this case "
        "and the docstring above must be rewritten, not the assertion.")

    nfail = sum(1 for _, ok, _ in results if not ok)
    print(f"\n{len(results)-nfail}/{len(results)} passed, {nfail} failed")
    print(f"synthetic inputs kept at {tmp}")
    return EX_PASS if nfail == 0 else EX_FAIL

def v_perspective(a):
    """Is an r(theta) outline a CIRCLE IN PERSPECTIVE, or a genuinely irregular one?

    A projected circle is an ellipse: its r(theta) carries a pure cos(2*theta) term, and its
    max and min sit exactly 90 deg apart. If it IS one, the MAJOR axis is the unforeshortened
    true diameter, because tilting a circle shortens one axis and leaves the perpendicular
    one alone - which recovers a true diameter from a tilted photograph.

    Reports the fraction of variance the cos(2theta) term explains OVER AND ABOVE a centre
    offset, so a mis-centred profile cannot masquerade as perspective.
    NEGATIVE CONTROL: the same fit on shuffled radii. If the real fit does not beat the
    shuffled best by a wide margin, the ellipse is not distinguishable from chance and the
    major-axis trick is NOT available - say so rather than using it anyway."""
    np = _np()
    d = json.load(open(a.json_in))
    node = d[a.key] if a.key in d else d
    prof = node[a.field]
    th = np.radians(np.array([q[0] for q in prof], float))
    r = np.array([q[1] for q in prof], float)
    pxmm = a.px_per_mm or d.get("px_per_mm")
    print(f"INPUT  {a.json_in} key={a.key} field={a.field}  n={len(r)}"
          + (f"  scale {pxmm} px/mm" if pxmm else "  NO SCALE - px only"))
    if len(r) < 40: die_cannot(f"only {len(r)} samples")
    A = np.stack([np.ones_like(th), np.cos(2*th), np.sin(2*th), np.cos(th), np.sin(th)], 1)
    A0 = np.stack([np.ones_like(th), np.cos(th), np.sin(th)], 1)
    def frac(rr):
        c, *_ = np.linalg.lstsq(A, rr, rcond=None)
        c0, *_ = np.linalg.lstsq(A0, rr, rcond=None)
        return 1 - ((rr - A @ c)**2).sum() / ((rr - A0 @ c0)**2).sum(), c
    f2, coef = frac(r)
    r0 = coef[0]; e = math.hypot(coef[1], coef[2]) / r0
    phi = math.degrees(math.atan2(coef[2], coef[1])) / 2 % 180
    amaj, amin = r0*(1+e), r0*(1-e)
    rng = np.random.default_rng(0)
    cmax = max(frac(rng.permutation(r))[0] for _ in range(a.control_trials))
    print(f"RESULT cos(2theta) explains {f2*100:.1f}% of variance beyond a centre offset")
    print(f"CONTROL shuffled best over {a.control_trials} trials: {cmax*100:.1f}%")
    print(f"       ellipticity e={e:.4f}  major axis phi={phi:.1f} deg  "
          f"axis ratio {amin/amaj:.4f}  implied tilt {math.degrees(math.acos(min(1,amin/amaj))):.1f} deg")
    if pxmm:
        print(f"       major-axis diameter {2*amaj/pxmm:.3f} mm   mean-radius diameter {2*r0/pxmm:.3f} mm")
    resid = r - A @ coef
    print(f"       residual after ellipse sd {resid.std():.2f} px (was {r.std():.2f} about the mean)")
    # ABSOLUTE FLOOR. Beating a shuffled control only says the term is not noise; it does not
    # say the term EXPLAINS the outline. Observed live: 7.5% explained beat a 1.4% control by
    # 5.4x and "passed", while the residual barely moved (8.58 -> 8.25 px). An ellipse that
    # explains 7% of the variance is not a description of the shape, and a true diameter must
    # not be read off it. So both gates must pass.
    if f2 < a.min_explained:
        print(f"VERDICT NOT usable - the cos(2theta) term explains only {f2*100:.1f}% of the "
              f"variance (floor {a.min_explained*100:.0f}%).")
        print("        Whatever dominates this outline, it is not perspective. The major-axis")
        print("        diameter above must NOT be used as a true diameter.")
        return EX_CANNOT
    if f2 <= a.margin * cmax:
        print(f"VERDICT NOT a projected circle - {f2*100:.1f}% does not beat {a.margin}x the "
              f"shuffled control ({a.margin*cmax*100:.1f}%).")
        print("        So the spread in r(theta) is NOT perspective. It is either a genuinely")
        print("        irregular outline or contamination in the edge detector - and the")
        print("        major-axis diameter above must NOT be used as a true diameter.")
        return EX_CANNOT
    print(f"VERDICT projected circle - major-axis diameter is the unforeshortened one")
    return EX_PASS


def v_turns(a):
    """Count the turns of a coil across its winding, and say what the count implies.

    Discriminates a FLAT SPIRAL from a SOLENOID wound in depth. Seen from above they can
    present the same radial band width, so band width alone does NOT establish turn count -
    a mistake this lane made once, calling two reads independent when both measured the same
    radial extent. Counting resolved conductors is the read that can disagree.

    Samples along many rays across the band, averages the profiles, and counts intensity
    peaks. NEGATIVE CONTROL: the same count on a shuffled profile must be far higher (noise
    produces many spurious peaks) - if the real profile is not much SMOOTHER than shuffled,
    the peaks are not resolved conductors and the answer is CANNOT DETERMINE."""
    np = _np()
    from scipy import ndimage as ndi
    path, im = _img(a.image)
    rgb = np.asarray(im.convert("RGB")).astype(float)
    H, W, _ = rgb.shape
    cx, cy = (a.centre if a.centre else ((W-1)/2, (H-1)/2))
    print(f"INPUT  image={os.path.basename(path)}  {W}x{H}  centre=({cx:.1f},{cy:.1f})")
    print(f"       band r {a.r_min}-{a.r_max} px, {a.n_rays} rays, "
          f"{'copper chroma R-B' if a.copper else 'luma'}")
    if a.px_per_mm: print(f"       scale {a.px_per_mm:.4f} px/mm")
    rs = np.arange(a.r_min, a.r_max, 0.25)
    prof = np.zeros_like(rs); used = 0
    for k in range(a.n_rays):
        th = 2*math.pi*(a.theta0 + a.theta_span*k/max(1,a.n_rays-1))/360.0
        ys = cy + rs*math.sin(th); xs = cx + rs*math.cos(th)
        if ys.min() < 0 or ys.max() >= H-1 or xs.min() < 0 or xs.max() >= W-1: continue
        y0 = ys.astype(int); x0 = xs.astype(int); fy = ys-y0; fx = xs-x0
        def bil(ch):
            return (ch[y0,x0]*(1-fy)*(1-fx) + ch[y0+1,x0]*fy*(1-fx)
                  + ch[y0,x0+1]*(1-fy)*fx + ch[y0+1,x0+1]*fy*fx)
        v = (bil(rgb[...,0]) - bil(rgb[...,2])) if a.copper else bil(rgb.mean(2))
        prof += v; used += 1
    if used < 3: die_cannot(f"only {used} rays fell inside the image")
    prof /= used
    sm = ndi.gaussian_filter1d(prof, a.smooth)
    def npeaks(x):
        d = np.diff(x)
        return int(((d[:-1] > 0) & (d[1:] <= 0) & (x[1:-1] > x.mean())).sum())
    n = npeaks(sm)
    rng = np.random.default_rng(0)
    ctrl = int(np.median([npeaks(ndi.gaussian_filter1d(rng.permutation(prof), a.smooth))
                          for _ in range(21)]))
    print(f"RESULT {used} rays averaged; {n} intensity peaks across the band")
    print(f"CONTROL shuffled profile median peaks: {ctrl}")
    if ctrl <= n:
        die_cannot(f"shuffled noise yields {ctrl} peaks vs {n} real - the peaks are not "
                   f"resolved conductors", remedy="use a sharper photograph or a wider band")
    print(f"CONTROL passed: real profile is smoother than noise ({n} < {ctrl})")
    band_px = a.r_max - a.r_min
    print(f"       band width {band_px:.1f} px" + (f" = {band_px/a.px_per_mm:.4f} mm" if a.px_per_mm else ""))
    if a.px_per_mm and n > 0:
        per = band_px/a.px_per_mm/n
        print(f"       -> {n} conductors over {band_px/a.px_per_mm:.4f} mm = {per*1000:.1f} um pitch")
        print(f"       AWG for that diameter: 40={0.0799}mm 38={0.1007}mm 36={0.1270}mm "
              f"35={0.1426}mm 34={0.1601}mm")
        if a.mean_dia_mm:
            L = n*math.pi*a.mean_dia_mm/1000.0
            A = math.pi*(per/2000.0)**2
            R = 1.68e-8*L/A if A > 0 else float('inf')
            print(f"       IF a FLAT SPIRAL of {n} turns at mean dia {a.mean_dia_mm} mm:")
            print(f"          conductor length {L*1000:.0f} mm, DC resistance ~{R:.2f} ohm")
            print(f"       A voice coil for a 4-8 ohm class-D amp needs several ohms.")
            print(f"       An NFC tag coil is a low-resistance few-turn loop.")
    if a.json_out:
        json.dump({"image": os.path.basename(path), "centre_px": [cx, cy],
                   "r_min_px": a.r_min, "r_max_px": a.r_max, "rays_used": used,
                   "peaks": n, "shuffle_control_peaks": ctrl, "px_per_mm": a.px_per_mm,
                   "band_width_px": band_px}, open(a.json_out, "w"), indent=2)
        print(f"WROTE  {a.json_out}")
    return EX_PASS


def v_doctor(a):
    print("boardmetro doctor\n")
    ok = True
    for mod in ("numpy", "PIL", "scipy"):
        try:
            m = __import__(mod)
            print(f"  PASS  {mod} {getattr(m,'__version__','?')}")
        except Exception as e:
            print(f"  FAIL  {mod}: {e}"); ok = False
    print(f"\n  image catalogue: {IMGDIR}")
    if not os.path.isdir(IMGDIR):
        print("  FAIL  catalogue directory missing"); ok = False
    else:
        imgs = sorted(f for f in os.listdir(IMGDIR) if f.lower().endswith((".jpg", ".jpeg", ".png")))
        print(f"  PASS  {len(imgs)} images present")
    # CANARY: a measurement whose answer is known, so a 'doctor' pass is a measurement
    canary = os.path.join(IMGDIR, "oflynn-frontside-26mm-cropped.jpg")
    if os.path.exists(canary):
        np = _np(); from PIL import Image
        from scipy import ndimage as ndi
        arr = np.asarray(Image.open(canary).convert("L")).astype(float)
        med = ndi.median_filter(arr, size=15)
        ys, xs = np.nonzero((arr < 190) & (med > 225))
        cx, cy, r, keep, res = fit_circle(xs, ys)
        want_r, want_c = 393.59, 393.50
        good = abs(r - want_r) < 0.5 and abs(cx - want_c) < 0.5 and res.std() < 1.0
        print(f"\n  CANARY  O'Flynn marker circle: r={r:.2f} (expect {want_r}), "
              f"centre=({cx:.2f},{cy:.2f}) (expect {want_c}), res sd={res.std():.3f}")
        print(f"  {'PASS' if good else 'FAIL'}  canary - a doctor pass is a MEASUREMENT, not a ping")
        ctrl = frame_control(cx, cy, r, arr.shape[1], arr.shape[0])
        print(f"  {'PASS' if ctrl else 'FAIL'}  frame control fires on this known-inscribed circle")
        ok = ok and good and bool(ctrl)
    else:
        print(f"\n  CANNOT DETERMINE: canary image absent"); return EX_CANNOT
    print()
    return EX_PASS if ok else EX_FAIL

# ---------------------------------------------------------------- rect (d_rect engine)
def _drect():
    sys.path.insert(0, os.path.join(HALO, "tools"))
    import d_rect
    return d_rect


def v_rect_selftest(a):
    print("boardmetro rect-selftest - the boundary-evidence engine\n")
    return EX_PASS if _drect().selftest() else EX_FAIL


def v_rect(a):
    """Rectangles by boundary evidence.

    A straight edge integrates the directional derivative COHERENTLY along its
    length (~L) while texture sums incoherently (~sqrt L), so the statistic is a
    line integral over an empirical null and NO absolute intensity enters it.
    Built because four intensity-based attempts on this project's own board failed
    by measurement, not by opinion (metrology/M08, M10, M11).

    --bar is not optional and there is no default: run this verb with --null first,
    read the number it prints, and pass it back.  A detector with an invented
    threshold is a decoration."""
    np = _np()
    D = _drect()
    from PIL import Image
    path, im = _img(a.image)
    lum = np.asarray(im.convert("L")).astype(float)
    mask = np.ones(lum.shape, bool)
    if a.region:
        mask[:] = False
        x0, y0, x1, y1 = a.region
        mask[y0:y1, x0:x1] = True
    d = max(1, a.down)
    L = D.downsample(lum, d)
    M = D.downsample(mask.astype(float), d) > 0.999
    ppmd = a.px_per_mm / d
    print(f"boardmetro rect - INPUT")
    print(f"  image      {path}  {im.size[0]}x{im.size[1]}")
    print(f"  region     {a.region if a.region else 'whole image'}")
    print(f"  scale      {a.px_per_mm} px/mm stored, {ppmd:.3f} px/mm at downsample {d}")
    print(f"  criteria   four sides, consistent polarity, score = MIN of the four |z|")
    if a.null:
        g = D.detect(L, M, ppmd, astep=a.astep, smooth=a.smooth, npeak=a.npeak,
                     nms=a.nms, z_thr=1.0, band=a.band, min_mm=a.min_mm, max_mm=a.max_mm)
        gs = D.detect(D.phase_scramble(L) if hasattr(D, "phase_scramble") else L, M, ppmd,
                      astep=a.astep, smooth=a.smooth, npeak=a.npeak, nms=a.nms,
                      z_thr=1.0, band=a.band, min_mm=a.min_mm, max_mm=a.max_mm)
        print(f"\n  NEGATIVE CONTROL - phase-scrambled copy of this image: identical power")
        print(f"  spectrum, no straight edge and no corner survives.")
        print(f"    real       n={len(g):5d}  max score {max((r['score'] for r in g), default=0):.2f}")
        print(f"    scrambled  n={len(gs):5d}  max score {max((r['score'] for r in gs), default=0):.2f}")
        print(f"\n  BAR = {max((r['score'] for r in gs), default=0):.2f}  -- pass it back as --bar.")
        return EX_PASS
    if a.bar is None:
        return die_cannot("no admission bar given. Run with --null first and pass the "
                          "number back as --bar; this verb refuses to invent a threshold")
    g = D.detect(L, M, ppmd, astep=a.astep, smooth=a.smooth, npeak=a.npeak, nms=a.nms,
                 z_thr=a.bar, band=a.band, min_mm=a.min_mm, max_mm=a.max_mm)
    g = D.maximal(g)
    print(f"\n  {len(g)} rectangles above the bar {a.bar}")
    for r in sorted(g, key=lambda r: -r["score"]):
        print(f"    {r['long_px']/ppmd:7.3f} x {r['short_px']/ppmd:7.3f} mm  theta "
              f"{r['theta_deg']:5.1f}  score {r['score']:7.2f}  at "
              f"({r['cx']*d:8.1f},{r['cy']*d:8.1f}) px  {r['polarity']}")
    if a.json_out:
        json.dump(dict(image=a.image, region=a.region, px_per_mm=a.px_per_mm,
                       downsample=d, bar=a.bar, n=len(g), rects=g),
                  open(a.json_out, "w"), indent=2)
        print(f"  wrote {a.json_out}")
    return EX_PASS if g else EX_CANNOT


def main():
    ap = argparse.ArgumentParser(prog="boardmetro", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="verb", required=True)
    sub.add_parser("doctor")
    sub.add_parser("selftest")
    c = sub.add_parser("circle"); c.add_argument("image")
    c.add_argument("--dark", type=float, default=190); c.add_argument("--ground", type=float, default=225)
    c.add_argument("--ground-window", type=int, default=15); c.add_argument("--band", type=float, default=2.0)
    c.add_argument("--min-pixels", type=int, default=100); c.add_argument("--min-arcs", type=int, default=3)
    c.add_argument("--max-residual", type=float, default=2.0)
    c.add_argument("--min-inlier-frac", type=float, default=0.85,
                   help="fraction of candidates that must lie on the circle (shape test)")
    c.add_argument("--min-uniformity", type=float, default=0.0,
                   help="OPT-IN. min/expected occupancy over 36 angular bins. Use ONLY when a "
                        "complete ring is expected; a clipped circle legitimately fails it. "
                        "Angular completeness is not circularity - inlier fraction is the shape test")
    c.add_argument("--mm", type=float, default=None, help="known diameter in mm, to emit a scale")
    c.add_argument("--region", type=int, nargs=4, default=None, metavar=("X0","Y0","X1","Y1"),
                   help="search only this box. Centre is reported in SOURCE pixels; the "
                        "frame control then tests tangency to the REGION, because the box "
                        "you drew IS the search frame.")
    c.add_argument("--expect-frame", action="store_true", help="you MEAN to measure the crop marker")
    c.add_argument("--json-out")
    s = sub.add_parser("scale-ruler"); s.add_argument("image")
    s.add_argument("--region", type=int, nargs=4, required=True, metavar=("X0","Y0","X1","Y1"))
    s.add_argument("--axis", choices=["x","y"], default="x")
    s.add_argument("--pitch-mm", type=float, default=1.0, help="mm per tick (1.0 for mm ticks)")
    s.add_argument("--min-pitch", type=int, default=3); s.add_argument("--max-pitch", type=int, default=400)
    s.add_argument("--min-peak", type=float, default=0.5)
    s.add_argument("--control-trials", type=int, default=8); s.add_argument("--json-out")
    r = sub.add_parser("radial"); r.add_argument("image")
    r.add_argument("--centre", type=float, nargs=2, default=None)
    r.add_argument("--r-min", type=float, default=0); r.add_argument("--r-max", type=float, default=400)
    r.add_argument("--bin", type=float, default=2.0); r.add_argument("--copper", action="store_true")
    r.add_argument("--px-per-mm", type=float, default=None); r.add_argument("--json-out")
    t = sub.add_parser("turns"); t.add_argument("image")
    t.add_argument("--centre", type=float, nargs=2, default=None)
    t.add_argument("--r-min", type=float, required=True); t.add_argument("--r-max", type=float, required=True)
    t.add_argument("--n-rays", type=int, default=64); t.add_argument("--theta0", type=float, default=0)
    t.add_argument("--theta-span", type=float, default=360)
    t.add_argument("--copper", action="store_true"); t.add_argument("--smooth", type=float, default=1.5)
    t.add_argument("--px-per-mm", type=float, default=None)
    t.add_argument("--mean-dia-mm", type=float, default=None)
    t.add_argument("--json-out")
    sub.add_parser("rect-selftest")
    q = sub.add_parser("rect"); q.add_argument("image")
    q.add_argument("--px-per-mm", type=float, required=True)
    q.add_argument("--region", type=int, nargs=4, default=None, metavar=("X0","Y0","X1","Y1"))
    q.add_argument("--down", type=int, default=4)
    q.add_argument("--astep", type=float, default=2.0); q.add_argument("--smooth", type=float, default=1.0)
    q.add_argument("--npeak", type=int, default=22); q.add_argument("--nms", type=int, default=3)
    q.add_argument("--band", type=int, default=1)
    q.add_argument("--min-mm", type=float, default=0.7); q.add_argument("--max-mm", type=float, default=9.0)
    q.add_argument("--bar", type=float, default=None,
                   help="admission score. NO DEFAULT: get it from --null on this same image")
    q.add_argument("--null", action="store_true", help="measure the bar and print it")
    q.add_argument("--json-out")
    e = sub.add_parser("perspective"); e.add_argument("json_in")
    e.add_argument("--key", default="outer"); e.add_argument("--field", default="r_theta_deg_px")
    e.add_argument("--px-per-mm", type=float, default=None)
    e.add_argument("--control-trials", type=int, default=200)
    e.add_argument("--margin", type=float, default=5.0,
                   help="real fit must beat this multiple of the shuffled control")
    e.add_argument("--min-explained", type=float, default=0.30,
                   help="absolute floor: fraction of variance the cos(2theta) term must "
                        "explain. Beating a noise control is not the same as describing "
                        "the shape")
    a = ap.parse_args()
    return {"doctor": v_doctor, "selftest": v_selftest, "circle": v_circle,
            "scale-ruler": v_scale_ruler, "radial": v_radial,
            "perspective": v_perspective, "turns": v_turns,
            "rect": v_rect, "rect-selftest": v_rect_selftest}[a.verb](a)

if __name__ == "__main__":
    sys.exit(main())
