		(comp
			(ref "U1")
			(value "nRF52832-QFAA-R")
			(footprint "Package_DFN_QFN:QFN-48-1EP_6x6mm_P0.4mm_EP4.4x4.4mm")
			(datasheet "https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.4.pdf")
			(description "Multiprotocol BLE/2.4GHz Cortex-M4 SoC, QFN-48")
			(fields
				(field
					(name "LCSC Part #") "CANNOT DETERMINE - no price pull was done by this lane; source against MPN")
				(field
					(name "MPN") "NRF52832-QFAA-R")
				(field
					(name "Package delta") "QFN-48 6x6x0.9 mm vs Apple's WLCSP-50 3.0x3.2x0.5 mm. THIS BOARD IS NOT THE SIZE OF AN AIRTAG, and it is a FORK not a compromise: the WLCSP fits Apple's ~6 mm annular ring and cannot be landed; the QFN can be landed and does not fit. No arrangement is both. Carry this into every downstream artifact.")
				(field
					(name "Stands in for") "U1")
				(field
					(name "Substitution basis") "THE SAME DIE AS APPLE'S, IN A PACKAGE THAT CAN BE LANDED. Apple fits the CIAA, WLCSP-50, and no complete ball map for it has ever been published - only ten of the fifty balls are sourced anywhere in this repository. The QFAA is QFN-48 6x6 P0.4, it is in KiCad's library with a verified land pattern, and it is stocked. THE FIDELITY SHEET IS ALREADY DRAWN WITH THIS SYMBOL, so on this board the pin NUMBERS are the part's own rather than merely right by signal name.")
				(field
					(name "Footprint") "Package_DFN_QFN:QFN-48-1EP_6x6mm_P0.4mm_EP4.4x4.4mm")
				(field
					(name "Datasheet") "https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.4.pdf")
				(field
					(name "Description") "Multiprotocol BLE/2.4GHz Cortex-M4 SoC, QFN-48")
			)
