			(ref "U3")
			(value "MX25R3235F 32Mb 1.65-3.6V")
			(footprint "Package_SO:JEITA_SOIC-8_3.9x4.9mm_P1.27mm")
			(datasheet "http://www.macronix.com/Lists/Datasheet/Attachments/7534/MX25R3235F,%20Wide%20Range,%2032Mb,%20v1.6.pdf")
			(description "32-Mbit, Wide Range Voltage SPI Serial Flash Memory, JEITA SOIC-8 (SOP-8)")
			(fields
				(field
					(name "LCSC Part #") "CANNOT DETERMINE - no price pull was done by this lane; source against MPN")
				(field
					(name "MPN") "MX25R3235FM1IL0")
				(field
					(name "Stands in for") "U3")
				(field
					(name "Substitution basis") "Apple's flash is a GD25LQ32C, which O'Flynn read out of the LIVE CHIP over SPI - and it is a 1.65-2.0 V part that CANNOT run on this board's 3 V rail. The MX25R is the same 32 Mbit density, runs 1.65-3.6 V so it works at both ends of the cell's discharge AND behind D1's forward drop, and is the lowest-power SPI NOR in KiCad's library. THIS SUBSTITUTION IS FORCED BY DELETING THE 1.8 V RAIL, and is the clearest example on this sheet of one departure making another necessary.")
				(field
					(name "Footprint") "Package_SO:JEITA_SOIC-8_3.9x4.9mm_P1.27mm")
				(field
					(name "Datasheet") "http://www.macronix.com/Lists/Datasheet/Attachments/7534/MX25R3235F,%20Wide%20Range,%2032Mb,%20v1.6.pdf")
				(field
					(name "Description") "32-Mbit, Wide Range Voltage SPI Serial Flash Memory, JEITA SOIC-8 (SOP-8)")
			)
			(libsource
				(lib "Memory_Flash")
