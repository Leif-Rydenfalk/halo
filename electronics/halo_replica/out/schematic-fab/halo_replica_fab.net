	(components
		(comp
			(ref "AE1")
			(value "2450AT18A100 2.4GHz chip")
			(footprint "RF_Antenna:Johanson_2450AT18x100")
			(datasheet "~")
			(description "Ceramic chip antenna with pin for PCB trace")
			(fields
				(field
					(name "LCSC Part #") "CANNOT DETERMINE - no price pull was done by this lane; source against MPN")
				(field
					(name "MPN") "2450AT18A100E")
				(field
					(name "Stands in for") "ANT1")
				(field
					(name "Substitution basis") "Apple's 2.4 GHz antenna is an inverted-F PRINTED ON THE PLASTIC CARRIER, and its geometry is CANNOT DETERMINE. A chip antenna is CHOSEN because it works on a board of any outline and needs no carrier: this board is meant to be switched on, not to be the right shape. THE MPN CARRIES ITS 'E': the catalogue has no part called 2450AT18A100, and x_lcsc_resolve matched that shorter string inside the longer 2450AT18A100E and returned a code for a part number this sheet did not name. Both ends were wrong and both are fixed - the matcher is token-exact, and this line now names what can actually be bought.")
				(field
					(name "Footprint") "RF_Antenna:Johanson_2450AT18x100")
				(field
					(name "Datasheet") "~")
				(field
					(name "Description") "Ceramic chip antenna with pin for PCB trace")
			)
