		(comp
			(ref "BT1")
			(value "3 SPRUNG CONTACTS (1 neg, 2 pos)")
			(datasheet "~")
			(description "Three sprung battery contacts: one negative dome on the well floor and TWO positive tabs on the wall. Both positives must see 3 V to boot; only the left carries the logic current, the right is sensed at ~50 nA. This is the connector-less battery interface and there is no catalogue land pattern for it.  [pinout: bom/bom.json BATT-CONTACTS; docs/REFERENCE-TEARDOWN.md 2.5 (O'Flynn: the big pads under the terminals are NOT connected; the real contacts are the small pads under the tabs).]")
			(fields
				(field
					(name "BOM confidence") "HIGH for the arrangement.")
				(field
					(name "BOM line") "BATT-CONTACTS")
				(field
					(name "BOM part") "3 sprung metal contacts — 1 negative dome on the well floor, 2 positive tabs on the wall")
				(field
					(name "Cell") "CR2032 3 V lithium coin cell; the FCC sample carried a Panasonic cell marked 'Made in Indonesia'")
				(field
					(name "Evidence class") "SEEN")
				(field
					(name "FP-basis") "PLACEHOLDER-L12")
				(field
					(name "Note") "L12 draws the land pattern. THE CELL IS NOT DRAWN ON THIS SHEET AS A PART: in the assembled tag the CR2032's top face touches BOTH positive fingers, so P+_POWER and P+_SENSE are one node THROUGH THE CELL AND ONLY THROUGH THE CELL. Drawing a battery symbol across them would short two nets that must be separate in copper - and that separation is the whole mechanism by which removal is detectable on both.")
				(field
					(name "Footprint")
				)
				(field
					(name "Datasheet") "~")
				(field
					(name "Description") "Three sprung battery contacts: one negative dome on the well floor and TWO positive tabs on the wall. Both positives must see 3 V to boot; only the left carries the logic current, the right is sensed at ~50 nA. This is the connector-less battery interface and there is no catalogue land pattern for it.  [pinout: bom/bom.json BATT-CONTACTS; docs/REFERENCE-TEARDOWN.md 2.5 (O'Flynn: the big pads under the terminals are NOT connected; the real contacts are the small pads under the tabs).]")
			)
			(libsource
