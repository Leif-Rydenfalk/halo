(version 1)
# Generated by ce-fab `fab dfm` from jlc-4layer.json
# JLCPCB 4-layer FR4, 1 oz outer / 0.5 oz inner — published capability limits
# Every rule below is a transcription of a published capability
# line; the quote and its URL are in the json this came from.

(rule "jlc_pad_to_track"
  # pad_to_track_min: Pad to track clearance
  (condition "A.Type == 'Pad' && B.Type == 'Track'")
  (constraint clearance (min 0.1mm))
)

(rule "jlc_smd_pad_to_pad"
  # smd_pad_to_pad_min: SMD pad to pad clearance, different nets
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm))
)

(rule "jlc_pth_to_track"
  # pth_to_track_min: PTH to track clearance
  (condition "A.Type == 'Pad' && A.isPlated() && B.Type == 'Track'")
  (constraint hole_clearance (min 0.28mm))
)

(rule "jlc_pad_hole_to_hole"
  # pad_hole_to_hole_min: PTH pad hole-to-hole spacing
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm))
)

(rule "jlc_inner_via_to_copper"
  # inner_via_to_copper_min: Inner-layer via hole to copper clearance
  (condition "A.Type == 'Via' && B.Layer == 'In1.Cu'")
  (constraint hole_clearance (min 0.2mm))
)

(rule "jlc_inner_pth_to_copper"
  # inner_pth_to_copper_min: Inner-layer PTH pad hole to copper clearance
  (condition "A.Type == 'Pad' && A.isPlated() && B.Layer == 'In2.Cu'")
  (constraint hole_clearance (min 0.3mm))
)

